# Cabeçalhos de segurança para Cloudflare Pages / Workers Static Assets.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://vlibras.gov.br https://*.vlibras.gov.br; style-src 'self' 'unsafe-inline' https://vlibras.gov.br https://*.vlibras.gov.br; img-src 'self' data: blob: https://vlibras.gov.br https://*.vlibras.gov.br; font-src 'self' data: https://vlibras.gov.br https://*.vlibras.gov.br; connect-src 'self' https://vlibras.gov.br https://*.vlibras.gov.br; worker-src 'self' blob:; media-src 'self' https://*.vlibras.gov.br; frame-src https://www.instagram.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto:; object-src 'none'; upgrade-insecure-requests

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=2592000

# Endereços de teste da Cloudflare (*.workers.dev e *.pages.dev) não entram no Google:
# só o domínio oficial deve ser indexado.
https://:worker.:conta.workers.dev/*
  X-Robots-Tag: noindex, nofollow
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

# vídeo: o navegador guarda por um dia (o arquivo não tem hash no nome)
/video/*
  Cache-Control: public, max-age=86400
