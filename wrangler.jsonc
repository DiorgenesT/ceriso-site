// Publicação na Cloudflare: arquivos estáticos (o export do Next em ./out) e um Worker mínimo para /video/*.
// Deploy: npm run build && npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ceriso",
  "compatibility_date": "2026-10-01",
  // Worker só para /video/* (pedidos parciais para o Safari); o resto é servido direto dos assets
  "main": "worker/index.js",
  // Domínios de produção (zona ceriso.com.br na conta Cloudflare dgtssk8@hotmail.com)
  "routes": [
    { "pattern": "ceriso.com.br", "custom_domain": true },
    { "pattern": "www.ceriso.com.br", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/video/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
